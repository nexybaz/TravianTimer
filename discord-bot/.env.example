# Discord Bot Token (Discord Developer Portal -> Application -> Bot -> Token)
DISCORD_BOT_TOKEN=your_discord_bot_token

# Supabase Edge Function URL (z.B. https://xyz.supabase.co/functions/v1/push-call)
SUPABASE_PUSH_URL=https://your-project.supabase.co/functions/v1/push-call

# Shared Secret (gleicher Wert wie BOT_SECRET in Supabase Secrets)
BOT_SECRET=your_shared_secret

# Komma-separierte Liste von Channel-IDs, die überwacht werden sollen
WATCHED_CHANNELS=123456789,987654321
